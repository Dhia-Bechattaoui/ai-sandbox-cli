[package]
name = "ai-sandbox"
version = "0.0.1"
edition = "2021"
description = "AI-Safe Sandboxing CLI for executing untrusted AI-generated code snippets deterministically and securely."
authors = ["NextGen Builder Team"]

[dependencies]
clap = { version = "4.4", features = ["derive"] }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
thiserror = "1.0"
