[package]
name = "ai-sandbox-cli"
version = "0.0.1"
edition = "2021"
description = "A high-performance CLI utility for secure, deterministic execution of untrusted AI-generated code snippets."
authors = ["Dhia Bechattaoui"]
license = "MIT"
repository = "https://github.com/dhia-bechattaoui/ai-sandbox-cli"
exclude = [
    "target/*",
    "Cargo.lock",
    ".git/*",
    ".agents/*"
]

[dependencies]
clap = { version = "4.4", features = ["derive"] }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
thiserror = "1.0"
